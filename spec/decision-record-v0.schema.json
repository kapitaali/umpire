{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umpire.dev/schemas/decision-record-v0.json",
  "title": "umpire decision record v0 (one JSONL line)",
  "description": "Full request/response payload of one typed decision. The ledger (xCABI 0.1 profile, vendor schema) carries identity only; this sidecar carries payloads. Every record joins 1:1 with its ledger declare/fault rows via recomputed identity (ref/contentHash echoes are cross-checked, not trusted).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "labels",
    "ref",
    "contentHash",
    "model_pin",
    "seed",
    "key",
    "probabilities",
    "confidence"
  ],
  "properties": {
    "schema": { "const": "decide-record/0.1" },
    "state": { "description": "opaque caller payload (text/JSON/image refs) — never mutated by umpire" },
    "labels": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 2,
      "maxItems": 255,
      "description": "caller order preserved; uniqueness enforced by the validator (set semantics in the ref use the sorted set)"
    },
    "ref": { "type": "string", "minLength": 1 },
    "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{8}$" },
    "model_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "weights_hash", "decoding"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "weights_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{8,64}$" },
        "decoding": { "type": "string", "minLength": 1 }
      }
    },
    "seed": { "type": "integer" },
    "key": { "type": "string", "minLength": 1 },
    "probabilities": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "calibrated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "data_version", "confidence"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "data_version": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "latency_ms": { "type": "integer", "minimum": 0 }
  }
}
