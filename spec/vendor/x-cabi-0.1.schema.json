{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxvm.dev/schemas/x-cabi-0.1.json",
  "title": "xCABI-0.1 \u2014 Context Budget Accounting Interface (RFC-0.1 addendum)",
  "description": "An xCABI-0.1 trace is a JSONL file: one event object per line. This schema validates each line independently (the array form is a convenience for test vectors).",
  "type": "object",
  "$defs": {
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)\\.[0-9]{3}Z$",
      "description": "RFC 3339 UTC timestamp with millisecond precision."
    },
    "logicalRef": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "minLength": 1
    },
    "pageId": {
      "type": "object",
      "required": [
        "logicalRef",
        "contentHash"
      ],
      "properties": {
        "logicalRef": {
          "$ref": "#/$defs/logicalRef"
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        }
      },
      "additionalProperties": false
    },
    "pageRef": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "tokens"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/pageId"
        },
        "kind": {
          "enum": [
            "file",
            "tool_result",
            "summary",
            "image_ref"
          ]
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "cacheEstimate": {
      "type": "object",
      "required": [
        "estHitTokens",
        "estMissTokens",
        "providerReported"
      ],
      "properties": {
        "estHitTokens": {
          "type": "integer",
          "minimum": 0
        },
        "estMissTokens": {
          "type": "integer",
          "minimum": 0
        },
        "providerReported": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "providerUsage": {
      "type": "object",
      "required": [
        "inputTokens",
        "outputTokens"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "renderMode": {
      "enum": [
        "full",
        "stub"
      ]
    },
    "faultSource": {
      "enum": [
        "tool_recall",
        "identifier_scan",
        "explicit_api",
        "semantic",
        "intentional_rerun"
      ]
    }
  },
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "type": "string"
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "session.open"
        },
        "agentId": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "budgetTokens": {
          "type": "integer",
          "minimum": 0
        },
        "tokenizerId": {
          "type": "string"
        },
        "schemaVersion": {
          "const": "0.1"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "agentId",
        "model",
        "provider",
        "budgetTokens",
        "tokenizerId"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "type": {
          "const": "page.declare"
        },
        "page": {
          "$ref": "#/$defs/pageRef"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "page"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "type": {
          "const": "page.render"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "$ref": "#/$defs/pageId"
        },
        "mode": {
          "$ref": "#/$defs/renderMode"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "turn",
        "page",
        "mode"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "type": {
          "const": "page.evict"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "$ref": "#/$defs/pageId"
        },
        "stubText": {
          "type": "string"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "turn",
        "page",
        "stubText"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "type": {
          "const": "page.fault"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "$ref": "#/$defs/pageId"
        },
        "source": {
          "$ref": "#/$defs/faultSource"
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "turn",
        "page",
        "source"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "type": {
          "const": "page.pin"
        },
        "page": {
          "$ref": "#/$defs/pageId"
        },
        "reason": {
          "type": "string"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "page",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "type": {
          "const": "page.unpin"
        },
        "page": {
          "$ref": "#/$defs/pageId"
        },
        "reason": {
          "type": "string"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "page",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "type": {
          "const": "turn.render"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "residentTokens": {
          "type": "integer",
          "minimum": 0
        },
        "evictedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "headroom": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ts": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "turn",
        "residentTokens",
        "evictedTokens"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "type": {
          "const": "call.meta"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "provider": {
          "type": "string"
        },
        "cacheEstimate": {
          "$ref": "#/$defs/cacheEstimate"
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        },
        "providerUsage": {
          "$ref": "#/$defs/providerUsage"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "turn",
        "provider",
        "cacheEstimate"
      ],
      "additionalProperties": false
    }
  ],
  "$comment": "VENDORED COPY 2026-10-31: ctxvm @ 36cec7c spec/rfc-0.1/x-cabi.schema-v0.1.json (RFC-0.1, D4 approved 2026-10-30). Verbatim except this $comment. Re-vendor on ctxvm schema bumps (00-SPEC \u00a77); the umpire profile rules (L1-L4) live in spec/validate_ledger.py, not here."
}
